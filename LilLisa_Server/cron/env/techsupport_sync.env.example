SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# Must be the same channel as lil-lisa TECHSUPPORT_CHANNEL_ID_IDA / _IDDM / _IDO
# (those three must also equal each other; the bot asserts that at startup).
TECHSUPPORT_CHANNEL_ID=your-techsupport-channel-id-here
ADMIN_CHANNEL_ID=your-admin-channel-id-here
# Product channels scanned nightly for expert corrections of a bot answer.
# Same channels lil-lisa answers questions in. All three are optional: a
# missing one simply disables that product's scan. Master switch (and the
# per-run thread cap) live in env/lillisa_server.env.
PRODUCT_CHANNEL_ID_IDA=your-ida-channel-id-here
PRODUCT_CHANNEL_ID_IDDM=your-iddm-channel-id-here
# PRODUCT_CHANNEL_ID_IDO=
# The bot's own Slack user id, used to tag its turns as "(bot)" when a thread
# is formatted for the classifier/correction prompts. Optional -- bot messages
# are still detected via bot_id without it.
LIL_LISA_SLACK_USERID=your-bot-user-id-here
# Expert identity for the product-channel scan. Same values as lil-lisa's
# lil-lisa.env; the Slack app needs the usergroups:read scope.
# Either the group ID (S0123ABCD, from usergroups.list) or its @handle
# (@rocknbot-certified-ida-experts); a handle is resolved to the ID at first use.
# REQUIRED: the product-channel scan fails loudly without EXPERT_GROUP_ID_IDA
# and _IDDM. IDO is optional.
EXPERT_GROUP_ID_IDA=your-expert-usergroup-id-here
EXPERT_GROUP_ID_IDDM=your-expert-usergroup-id-here
# EXPERT_GROUP_ID_IDO=
# How long expert group membership is cached before Slack is asked again (seconds, default 300)
# EXPERT_GROUP_CACHE_SECONDS=300
