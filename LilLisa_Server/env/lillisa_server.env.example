# Copy this file to lillisa_server.env (gitignored). Never put real secrets in this .example file.
LOG_LEVEL=info
SPEEDICT_FOLDERPATH=./speedict
LANCEDB_FOLDERPATH=./lancedb
OPENAI_API_KEY_FILEPATH=./passwords/openai_api_key
VOYAGE_API_KEY_FILEPATH=./passwords/voyage_api_key
LLM_API_KEY_FILEPATH=./passwords/litellm_api_key
AWS_ACCESS_KEY_ID_FILEPATH=./passwords/aws_access_key_id
AWS_SECRET_ACCESS_KEY_FILEPATH=./passwords/aws_secret_access_key
QA_SYSTEM_PROMPT_FILEPATH=./data/prompts/qa_system_prompt.txt
QA_USER_PROMPT_FILEPATH=./data/prompts/qa_user_prompt.txt
REACT_AGENT_PROMPT_FILEPATH=./data/prompts/react_agent_prompt.txt
AUTHENTICATION_KEY=your-auth-key-here
DOCUMENTATION_FOLDERPATH=./data/documentation
QA_PAIRS_GITHUB_REPO_URL=https://github.com/your-org/your-golden-qa-pairs-repo.git
# Pushes to the repo above use GITHUB_TOKEN from cron/env/github_push.env,
# the same token that pushes the verified techsupport markdown. Never put a
# token in QA_PAIRS_GITHUB_REPO_URL.
QA_PAIRS_FOLDERPATH=./data/qa_pairs

# Tech support integration settings
TECHSUPPORT_REEMBED_INTERVAL_DAYS=7
TECHSUPPORT_SYNC_INTERVAL_HOURS=24
# Nightly parent latest_reply lookups for known threads (not full replies).
TECHSUPPORT_SYNC_HOT_DAYS=30
# Periodic catch-up: also refresh known threads quieter than hot, but not older than this.
TECHSUPPORT_SYNC_CATCHUP_AGE_DAYS=90
TECHSUPPORT_SYNC_CATCHUP_INTERVAL_DAYS=7
# Cap on each of the hot set and the catch-up set (hottest first).
TECHSUPPORT_SYNC_MAX_PARENT_LOOKUPS=200
# Nightly scan of the IDA/IDDM/IDO product channels for expert replies that
# correct or augment a bot answer (PRODUCT_CHANNEL_ID_* in
# cron/env/techsupport_sync.env). Set to false to turn the whole pass off.
TECHSUPPORT_SCAN_PRODUCT_CHANNELS=true
# Per-product cap on threads classified per run; the rest wait for the next
# run, hottest first.
PRODUCT_SCAN_MAX_THREADS_PER_RUN=50
# How far back the FIRST scan of a product channel looks. Without it a channel
# with no state is synced from the beginning of time, so its whole backlog gets
# classified. Later runs just resume where the previous one stopped.
PRODUCT_SCAN_INITIAL_LOOKBACK_DAYS=30
# nightly_pipeline.reload_techsupport_index() posts to this; the pipeline runs
# inside the API process, so the loopback default is correct.
LIL_LISA_SERVER_URL=http://127.0.0.1:8000
# How often the API process checks whether the nightly pipeline is due. Real
# work is still gated by TECHSUPPORT_SYNC_INTERVAL_HOURS, so this only needs to
# be more frequent than that -- it is not the nightly schedule itself.
TECHSUPPORT_PIPELINE_TICK_MINUTES=60

# Product versions -- fill in with your actual supported versions
IDDM_PRODUCT_VERSIONS=
IDA_PRODUCT_VERSIONS=
DOCUMENTATION_NEW_VERSIONS=
DOCUMENTATION_EOC_VERSIONS=
DOCUMENTATION_IDENTITY_ANALYTICS_VERSIONS=
DOCUMENTATION_IA_PRODUCT_VERSIONS=
DOCUMENTATION_IA_SELFMANAGED_VERSIONS=

MAX_ITERATIONS=5
SESSION_LIFETIME_DAYS=30
LLM_MODEL=your-model-name-here

# Auth/session related
AUTH_INFO_FOLDENAME=auth_info
CONVERSATION_HISTORY_FOLDENAME=conversation_history
GLOBAL_AUTH_TOKENS_FILENAME=global_auth_tokens.json
JWT_SECRET_KEY=your-jwt-secret-here
JWT_ALGORITHM=HS256
EMAIL_HASH_SALT=your-email-hash-salt-here
FRONTEND_URL=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_TOKEN_EXPIRE_MINUTES=15
BLOCKED_EMAIL_DOMAINS=

# Mail settings (if email features are used)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=

# Optional -- only needed if IDO product support is configured
# IDO_PRODUCT_VERSIONS=
# DOCUMENTATION_IDO_VERSIONS=
